{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeoMeta Schema",
  "description": "Schema for GeoMeta properties in GeoJSON features",
  "type": "object",
  "properties": {
    "driving_side": {
      "type": ["array", "null"],
      "description": "Which side of the road vehicles drive on",
      "items": {
        "type": "string",
        "enum": ["left", "right"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hemisphere": {
      "type": ["string", "null"],
      "description": "Hemisphere the country is located in",
      "enum": ["N", "S", "E"]
    },
    "road_lines": {
      "type": ["array", "null"],
      "description": "Common valid road line marking profiles. Null means unknown/not entered; use a profile with type 'none' when roads commonly have no visible line markings.",
      "items": {
        "$ref": "#/definitions/roadLineProfile"
      },
      "minItems": 1
    },
    "road_quality": {
      "type": ["array", "null"],
      "description": "Quality of roads in the country",
      "items": {
        "type": "string",
        "enum": ["maintained", "poor"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
            "has_official_coverage": {
          "type": ["boolean", "null"],
          "description": "Whether the country has official street view coverage"
        },
    "arid_lush": {
      "type": ["object", "null"],
      "description": "Scale from arid to lush vegetation (quintile scale 1-5)",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Minimum value on the arid-lush scale (1=very arid, 5=very lush)"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum value on the arid-lush scale (1=very arid, 5=very lush)"
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "cold_hot": {
      "type": ["object", "null"],
      "description": "Scale from cold to hot climate (quintile scale 1-5)",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Minimum value on the cold-hot scale (1=very cold, 5=very hot)"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum value on the cold-hot scale (1=very cold, 5=very hot)"
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "flat_mountainous": {
      "type": ["object", "null"],
      "description": "Scale from flat to mountainous terrain (quintile scale 1-5)",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Minimum value on the flat-mountainous scale (1=very flat, 5=very mountainous)"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum value on the flat-mountainous scale (1=very flat, 5=very mountainous)"
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "soil_color": {
      "type": ["array", "null"],
      "description": "Colors of soil found in the country",
      "items": {
        "type": "string",
        "enum": ["red", "brown", "gray", "black", "other"]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "driving_side",
    "hemisphere",
    "road_lines",
    "road_quality",
    "has_official_coverage",
    "arid_lush",
    "cold_hot",
    "flat_mountainous",
    "soil_color"
  ],
  "additionalProperties": false,
  "definitions": {
    "roadLineProfile": {
      "oneOf": [
        {
          "type": "object",
          "description": "A valid combination of inner and/or outer road line markings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["marked"],
              "description": "Profile type for roads with visible line markings"
            },
            "inner": {
              "type": "array",
              "description": "Center/inner lane-divider line markings.",
              "items": {
                "$ref": "#/definitions/roadLineMarking"
              },
              "minItems": 1
            },
            "outer": {
              "type": "array",
              "description": "Outer/edge line markings.",
              "items": {
                "$ref": "#/definitions/roadLineMarking"
              },
              "minItems": 1
            }
          },
          "required": ["type"],
          "anyOf": [
            { "required": ["inner"] },
            { "required": ["outer"] }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Roads commonly have no visible line markings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["none"]
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "roadLineMarking": {
      "type": "object",
      "description": "Individual road line marking.",
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["solid", "short_dashed", "long_dashed", "other"],
          "description": "Line pattern"
        },
        "number": {
          "type": "string",
          "enum": ["single", "double", "triple"],
          "description": "Number of parallel lines"
        },
        "color": {
          "type": "string",
          "enum": ["white", "yellow", "orange", "other"],
          "description": "Line color"
        }
      },
      "required": ["pattern", "number", "color"],
      "additionalProperties": false
    }
  }
}

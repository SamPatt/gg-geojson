{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeoJSON with GeoMeta Schema",
  "description": "Complete GeoJSON schema including GeoMeta properties",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["FeatureCollection"],
      "description": "Type of GeoJSON object"
    },
    "features": {
      "type": "array",
      "description": "Array of GeoJSON features",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Feature"],
            "description": "Type of feature"
          },
          "geometry": {
            "type": "object",
            "description": "Geometry of the feature",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Polygon", "MultiPolygon"],
                "description": "Type of geometry"
              },
              "coordinates": {
                "type": "array",
                "description": "Array of coordinate arrays defining the geometry"
              }
            },
            "required": ["type", "coordinates"],
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "description": "Properties of the feature",
            "properties": {
              "ADMIN": {
                "type": "string",
                "description": "Country/territory name"
              },
              "ISO_A3": {
                "type": "string",
                "description": "ISO 3166-1 alpha-3 country code",
                "pattern": "^[A-Z]{3}$"
              },
              "ISO_A2": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 country code",
                "pattern": "^[A-Z]{2}$"
              },
              "geo_meta": {
                "$ref": "#/definitions/geoMeta"
              }
            },
            "required": ["ADMIN", "ISO_A3", "ISO_A2"],
            "additionalProperties": true
          }
        },
        "required": ["type", "geometry", "properties"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["type", "features"],
  "additionalProperties": false,
  "definitions": {
    "geoMeta": {
      "type": "object",
      "description": "GeoMeta properties",
      "properties": {
        "driving_side": {
          "type": ["array", "null"],
          "description": "Which side of the road vehicles drive on",
          "items": {
            "type": "string",
            "enum": ["left", "right"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
            "hemisphere": {
      "type": ["string", "null"],
      "description": "Hemisphere the country is located in",
      "enum": ["N", "S", "E"]
    },
        "road_lines": {
          "type": ["array", "null"],
          "description": "Common valid road line marking profiles. Null means unknown/not entered; use a profile with type 'none' when roads commonly have no visible line markings.",
          "items": {
            "$ref": "#/definitions/roadLineProfile"
          },
          "minItems": 1
        },
        "road_quality": {
          "type": ["array", "null"],
          "description": "Quality of roads in the country",
          "items": {
            "type": "string",
            "enum": ["maintained", "poor"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "has_official_coverage": {
          "type": ["boolean", "null"],
          "description": "Whether the country has official street view coverage"
        },
        "arid_lush": {
          "anyOf": [
            {"$ref": "#/definitions/quintileScale"},
            {"type": "null"}
          ]
        },
        "cold_hot": {
          "anyOf": [
            {"$ref": "#/definitions/quintileScale"},
            {"type": "null"}
          ]
        },
        "flat_mountainous": {
          "anyOf": [
            {"$ref": "#/definitions/quintileScale"},
            {"type": "null"}
          ]
        },
        "soil_color": {
          "type": ["array", "null"],
          "description": "Colors of soil found in the country",
          "items": {
            "type": "string",
            "enum": ["red", "brown", "gray", "black", "other"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "driving_side",
        "hemisphere",
        "road_lines",
        "road_quality",
        "has_official_coverage",
        "arid_lush",
        "cold_hot",
        "flat_mountainous",
        "soil_color"
      ],
      "additionalProperties": false
    },
    "roadLineProfile": {
      "oneOf": [
        {
          "type": "object",
          "description": "A valid combination of inner and/or outer road line markings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["marked"],
              "description": "Profile type for roads with visible line markings"
            },
            "inner": {
              "type": "array",
              "description": "Center/inner lane-divider line markings.",
              "items": {
                "$ref": "#/definitions/roadLineMarking"
              },
              "minItems": 1
            },
            "outer": {
              "type": "array",
              "description": "Outer/edge line markings.",
              "items": {
                "$ref": "#/definitions/roadLineMarking"
              },
              "minItems": 1
            }
          },
          "required": ["type"],
          "anyOf": [
            { "required": ["inner"] },
            { "required": ["outer"] }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Roads commonly have no visible line markings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["none"]
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "roadLineMarking": {
      "type": "object",
      "description": "Individual road line marking.",
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["solid", "short_dashed", "long_dashed", "other"],
          "description": "Line pattern"
        },
        "number": {
          "type": "string",
          "enum": ["single", "double", "triple"],
          "description": "Number of parallel lines"
        },
        "color": {
          "type": "string",
          "enum": ["white", "yellow", "orange", "other"],
          "description": "Color of the road lines"
        }
      },
      "required": ["pattern", "number", "color"],
      "additionalProperties": false
    },
    "quintileScale": {
      "type": "object",
      "description": "Quintile scale object with min and max values (1-5)",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Minimum value on the scale"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum value on the scale"
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    }
  }
} 
